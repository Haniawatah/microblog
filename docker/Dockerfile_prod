FROM python:3.8-alpine

# Dedicated user for the app the image should not run as root
RUN adduser -D -u 1000 microblog

WORKDIR /home/microblog

COPY requirements.txt requirements.txt
COPY requirements/prod.txt requirements/prod.txt

# Build tools are only needed in here while the packages are installed, remove them again
# hadolint ignore=DL3018
RUN apk --no-cache add --virtual build-dependencies build-base libffi-dev openssl-dev \
  && pip install --no-cache-dir -r requirements.txt \
  && apk del build-dependencies

COPY --chown=microblog:microblog app app
COPY --chown=microblog:microblog migrations migrations
COPY --chown=microblog:microblog microblog.py ./
COPY --chown=microblog:microblog --chmod=755 boot.sh ./

# The version is sent in as a build argument from CI/CD and docker-compose
ARG APP_VERSION=unknown
ENV APP_VERSION=${APP_VERSION}

ENV FLASK_APP=microblog.py

# The user is created in this image with adduser, so the name is always resolvable here

USER 1000

EXPOSE 5000
ENTRYPOINT ["./boot.sh"]
