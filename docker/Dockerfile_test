FROM python:3.8-alpine

# Keep the container from writing __pycache__ into the mounted volumes
ENV PYTHONDONTWRITEBYTECODE=1

WORKDIR /home/microblog


# hadolint ignore=DL3018
RUN apk --no-cache add make

COPY requirements.txt requirements.txt
COPY requirements/prod.txt requirements/prod.txt
COPY requirements/test.txt requirements/test.txt

# hadolint ignore=DL3018
RUN apk --no-cache add --virtual build-dependencies build-base libffi-dev openssl-dev \
  && pip install --no-cache-dir -r requirements/test.txt \
  && apk del build-dependencies

# The files make test needs app and tests are mounted as volumes
COPY Makefile pytest.ini .pylintrc .coveragerc ./
COPY --chmod=755 docker/test.sh ./

ENTRYPOINT ["./test.sh"]
